{
  "name": "acidum-sync",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "observability": { "enabled": false },
  "d1_databases": [
    { "binding": "DB", "database_name": "acidum-sync", "database_id": "YOUR_DATABASE_ID" },
  ],
  "durable_objects": { "bindings": [{ "name": "QUOTA", "class_name": "SyncQuota" }] },
  "migrations": [{ "tag": "quota-v1", "new_sqlite_classes": ["SyncQuota"] }],
  "triggers": { "crons": ["17 * * * *"] },
}
